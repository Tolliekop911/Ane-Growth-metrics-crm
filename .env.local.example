# ─────────────────────────────────────────────────────────────
#  ANE Growth CRM — environment variables
#  Copy this file to ".env.local" for local dev, and add the same
#  values in Vercel (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# From the company owner's Supabase project:
#   Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# The "service_role" secret key (server-side only — keep it private).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The single shared password that unlocks the /inbox page.
# Pick anything you like and give it to whoever needs to read inquiries.
INBOX_PASSWORD=change-this-password
